@startuml casos-de-uso
!include _estilo.iuml
title FilaCero · Diagrama de casos de uso
left to right direction

actor "Ciudadano" as C
actor "Asesor\n(AGENTE)" as A
actor "Supervisor" as S
actor "Administrador" as AD
actor "Público en sala\n(TV de la sede)" as TV
actor "Proveedor SMS\n«sistema»" as SMS
AD -|> S

rectangle "FilaCero" {
  package "Portal ciudadano" {
    usecase "Verificar celular\ncon OTP" as UC01
    usecase "Reservar turno\nen una franja" as UC02
    usecase "Consultar turno\n(por código o celular)" as UC03
    usecase "Cancelar turno" as UC04
    usecase "Elegir equipo listo\npara recoger" as UC05
    usecase "Registrar garantía\n(compra ≤ 1 año)" as UC06
    usecase "Radicar reclamo\n(en línea o en persona)" as UC07
    usecase "Conversar por minichat\ncon el asesor" as UC08
  }
  package "Consola del asesor" {
    usecase "Iniciar sesión\n(JWT)" as UC10
    usecase "Consultar cola\nde la sede" as UC11
    usecase "Llamar turno\n(con voz cada 20 s)" as UC12
    usecase "Atender turno\n(iniciar / finalizar)" as UC13
    usecase "Marcar no asistió /\ndevolver a la cola" as UC14
    usecase "Preparar pedido\nantes de la llegada" as UC15
    usecase "Recibir / entregar equipo\n(verifica cédula)" as UC16
    usecase "Gestionar reclamo" as UC17
    usecase "Declarar presencia\n(pausa, almuerzo…)" as UC18
    usecase "Consultar Copiloto IA" as UC19
  }
  package "Panel administrativo" {
    usecase "Ver tablero ejecutivo\ne indicadores" as UC20
    usecase "Gestionar sedes,\ntrámites y franjas" as UC21
    usecase "Gestionar asesores\ny usuarios (baja lógica)" as UC22
    usecase "Consultar historial\ny auditoría" as UC23
    usecase "Consultar Analista IA" as UC24
  }
  usecase "Ver turnos llamados\nen pantalla de sala" as UC30
}

C --> UC02
C --> UC03
C --> UC04
C --> UC07
C --> UC08
UC02 ..> UC01 : <<include>>
UC03 ..> UC01 : <<include>>
UC04 ..> UC01 : <<include>>
UC07 ..> UC01 : <<include>>
UC05 ..> UC02 : <<extend>>\n[trámite = entrega]
UC06 ..> UC02 : <<extend>>\n[trámite = garantía]
UC01 --> SMS

A --> UC11
A --> UC12
A --> UC13
A --> UC14
A --> UC15
A --> UC16
A --> UC17
A --> UC18
A --> UC19
UC11 ..> UC10 : <<include>>
UC17 ..> UC08 : <<include>>

S --> UC20
S --> UC23
S --> UC24
AD --> UC21
AD --> UC22
UC20 ..> UC10 : <<include>>

TV --> UC30
@enduml
