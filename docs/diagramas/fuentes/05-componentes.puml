@startuml componentes
!include _estilo.iuml
title FilaCero · Arquitectura UML (diagrama de componentes)

actor Ciudadano
actor Asesor
actor "Admin /\nSupervisor" as Adm
actor "TV de sala" as TV

component "SPA FilaCero\n«HTML + CSS + JS módulos ES»" as SPA {
  portin "~#/" as p1
  portin "~#/agente" as p2
  portin "~#/admin/:seccion" as p3
  portin "~#/sala" as p4
  [router + guards] as RG
  [pages + components] as PC
  [api/http.js\n(único fetch)] as HTTP
  [auth/session.service] as SES
  [utils/voz.js\n(Web Speech API)] as VOZ
  RG --> PC
  PC --> HTTP
  PC --> VOZ
  HTTP --> SES
}
Ciudadano --> p1
Asesor --> p2
Adm --> p3
TV --> p4

component "API FilaCero\n«Flask 3 · monolito modular»" as API {
  portin "REST /api/v1" as rest
  [Blueprints\n(controladores)] as CT
  [Servicios de dominio] as SV
  [Repositorios] as RP
  [Modelos ORM\n+ TenantScoped] as MD
  [Seguridad\nJWT · roles · rate limit] as SG
  [Multiempresa\n(tenancy)] as TN
  [Auditoría] as AU
  [Asistente IA\n(motor local / Claude opc.)] as IA
  rest --> CT
  CT --> SG
  CT --> SV
  CT --> AU
  SV --> RP
  RP --> MD
  MD --> TN
  CT --> IA
  IA --> SV
}
HTTP --> rest : JSON · Bearer JWT\no X-Organization-Slug

database "MySQL 8\nfilacero_db" as DB
MD --> DB : SQL · FOR UPDATE\nREAD COMMITTED
cloud "Proveedor SMS\n(OTP)" as SMS
cloud "API Anthropic\n(opcional)" as LLM
SV ..> SMS : HTTPS (simulado en demo)
IA ..> LLM : HTTPS (si hay API key)
@enduml
