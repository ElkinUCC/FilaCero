@startuml clases
!include _estilo.iuml
title FilaCero · Diagrama de clases del dominio
hide empty members

note as NT
  Todas las clases con «tenant» heredan el mixin
  **TenantScoped** (app/tenancy.py): columna
  organizacion_id + filtro automático del ORM.
end note

class Organizacion {
  + id : int
  + nombre : str
  + slug : str {unique}
  + zona_horaria : str
  + plan : str
  + estado : str
  + activa() : bool
}

class Usuario <<tenant>> {
  + id : int
  + nombre : str
  + correo : str {unique}
  + celular : str
  + documento : str
  + rol : Rol
  + activo : bool
  + modulo : str
  + presencia : Presencia
  + version_sesion : int
  + eliminado_en : datetime
  + revocar_sesiones()
  + token_vigente(payload) : bool
  + protegida() : bool
}

class Punto <<tenant>> <<Sede>> {
  + id : int
  + nombre : str
  + direccion : str
  + activo : bool
}

class Tramite <<tenant>> {
  + id : int
  + nombre : str
  + tipo_flujo : TipoFlujo
  + requiere_preparacion : bool
  + tiempo_estimado : int
  + campos_solicitud : JSON
  + activo : bool
}

class Franja <<tenant>> {
  + id : int
  + fecha : date
  + hora_inicio : time
  + hora_fin : time
  + capacidad : int
  + activa : bool
}

class Turno <<tenant>> {
  + id : int
  + codigo : str {unique}
  + estado : EstadoTurno
  + hora_solicitud : datetime
  + fecha_llamado / inicio / fin : datetime
  + estado_preparacion : EstadoPreparacion
  + nota_preparacion : str
  + respuestas_solicitud : JSON
  + codigo_corto() : str
}

class Equipo <<tenant>> {
  + id : int
  + codigo : str {unique}
  + marca / modelo / serial : str
  + origen : REPARACION | GARANTIA
  + fecha_compra : date
  + estado : EstadoEquipo
  + fecha_entrega : datetime
}

class Reclamo <<tenant>> {
  + id : int
  + radicado : str {unique}
  + categoria : str
  + presencial : bool
  + estado : RADICADO | EN_GESTION | RESUELTO
  + respuesta : str
}

class MensajeReclamo <<tenant>> {
  + id : int
  + autor : CLIENTE | ASESOR | ASISTENTE
  + texto : str
  + leido_cliente : bool
  + leido_asesor : bool
}

class Auditoria <<tenant>> {
  + id : int
  + fecha : datetime
  + accion : str
  + detalle : str
  + ip : str
}

enum EstadoTurno {
  ESPERANDO
  LLAMADO
  EN_ATENCION
  ATENDIDO
  NO_ASISTIO
  CANCELADO
}
enum EstadoPreparacion {
  PENDIENTE
  EN_PREPARACION
  LISTO
  NOVEDAD
}
enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  CLIENTE
}


Organizacion "1" *-- "0..*" Usuario
Punto "1" o-- "0..*" Franja : ofrece >
Tramite "1" o-- "0..*" Franja
Franja "1" o-- "0..*" Turno : contiene >
Usuario "1" -- "0..*" Turno : reserva >
Usuario "0..1" -- "0..*" Turno : atiende >
Punto "0..1" -- "0..*" Usuario : sede asignada <
Usuario "1" -- "0..*" Equipo : es dueño >
Punto "1" -- "0..*" Equipo : recibe >
Equipo "0..1" -- "0..*" Turno : se entrega en >
Usuario "1" -- "0..*" Reclamo : radica >
Reclamo "1" *-- "0..*" MensajeReclamo
Reclamo "0..1" -- "0..*" Turno : se sigue en >
Usuario "0..1" -- "0..*" Auditoria : genera >
Turno ..> EstadoTurno
Turno ..> EstadoPreparacion
Usuario ..> Rol

@enduml
