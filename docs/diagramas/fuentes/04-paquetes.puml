@startuml paquetes
!include _estilo.iuml
title FilaCero · Diagrama de paquetes (monolito modular por capas y dominios)

package "frontend (SPA vanilla: HTML + CSS + JS)" as FE {
  package "js/router" as fr
  package "js/pages" as fp
  package "js/components" as fc
  package "js/api" as fa
  package "js/auth" as fau
  package "js/utils" as fu
}
fr ..> fp
fp ..> fc
fc ..> fa
fc ..> fu
fa ..> fau
fr ..> fau

package "backend/app (API Flask · un proceso)" as BE {
  package "Transversal" as T {
    package "seguridad" as seg
    package "tenancy" as ten
    package "errores" as err
    package "horario" as hor
    package "config" as cfg
  }
  package "dominios" as D {
    package "organizaciones" as org
    package "usuarios" as usu
    package "sedes" as sed
    package "tramites" as tra
    package "franjas" as fra
    package "turnos" as tur
    package "agentes\n(atención y despacho)" as age
    package "equipos" as equ
    package "reclamos" as rec
    package "auditoria" as aud
    package "asistente (IA)" as asi
  }
}

fa ..> BE : REST/JSON /api/v1

age ..> tur
age ..> usu
age ..> equ
age ..> rec
tur ..> fra
tur ..> equ
tur ..> rec
tur ..> usu
fra ..> sed
fra ..> tra
equ ..> usu
rec ..> equ
asi ..> age : reutiliza servicios\n(tablero, cola)
asi ..> tur
usu ..> aud
equ ..> aud
rec ..> aud
age ..> aud
D ..> T

note bottom of D
  Cada dominio contiene sus capas:
  controladores → servicios → repositorios → modelos (+ dtos)
  Dependencias detectadas solo a nivel de modelo/repositorio
  (importación diferida): turnos ↔ agentes, franjas → turnos.Turno,
  usuarios → turnos.Turno (trade-off T-13, riesgo R-11).
end note
@enduml
