@startuml secuencia-atencion
!include _estilo.iuml
title FilaCero · Secuencia: llamar y atender un turno (consola del asesor y sala)
autonumber
actor Asesor
participant "SPA\nAgentePage.js" as SPA
participant "utils/voz.js" as V
participant "agentes.controladores" as C
participant "seguridad\n@requiere_rol" as SG
participant "agentes.servicios" as S
participant "auditoria" as AU
participant "turnos.controladores\n(público)" as TC
database "MySQL" as DB
participant "SPA SalaPage\n(TV)" as TV

Asesor -> SPA : "Llamar a Juliana"
SPA -> C : POST /agente/turnos/{id}/llamar (Bearer JWT)
C -> SG : validar token, versión de sesión y rol AGENTE
SG -> DB : SELECT usuario (rol vigente)
C -> S : llamar_turno(agente, turno)
S -> DB : SELECT turno … FOR UPDATE
S -> DB : UPDATE estado=LLAMADO, fecha_llamado
C -> AU : registrar("turno_llamado")
C --> SPA : 200 turno
SPA -> V : anunciar("Turno …, Módulo 2")
loop cada 20 s mientras siga LLAMADO
  V -> V : repetir anuncio
end
loop polling cada 4 s
  TV -> TC : GET /turnos/publico/sala?sede_id=ID
  TC --> TV : turnos llamados (sin celular)
end
Asesor -> SPA : Iniciar / Finalizar
SPA -> C : POST …/iniciar · …/finalizar
C -> S : iniciar_atencion / finalizar_atencion
S -> DB : UPDATE estado=EN_ATENCION → ATENDIDO
C --> SPA : 200
@enduml
