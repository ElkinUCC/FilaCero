flowchart TB
    subgraph presentacion ["Presentación (frontend-react)"]
        direction LR
        cli["cliente/<br/>portal, reserva, consulta"]:::componente
        adm["admin/<br/>panel y seguridad"]:::componente
        age["agente/<br/>consola"]:::componente
        sal["sala/<br/>pantalla"]:::componente
        ui["ui/<br/>componentes, accesibilidad"]:::componente
    end

    subgraph api ["API REST /api/v1 (backend/app)"]
        direction TB
        ctrl["<b>Controladores</b> (Blueprints por dominio)<br/>validan entrada, autorizan, traducen errores"]:::contenedor
        serv["<b>Servicios</b><br/>reglas de negocio: cupo por sede, OTP,<br/>ciclo de atención, despacho EDF, permisos"]:::contenedor
        repo["<b>Repositorios / modelos</b><br/>SQLAlchemy: consultas, bloqueos, transacciones"]:::contenedor
        trans["<b>Transversal</b><br/>seguridad.py · horario.py · config.py · auditoría"]:::componente
    end

    bd[("MySQL")]:::datos

    cli & adm & age & sal --> ui
    presentacion -- "HTTP + JSON (api.js)" --> ctrl
    ctrl --> serv --> repo --> bd
    ctrl -.-> trans
    serv -.-> trans
