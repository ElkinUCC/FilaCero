flowchart TB
    ciudadano["<b>Ciudadano</b><br/>[Persona]"]:::persona
    personal["<b>Asesor · Admin · Supervisor</b><br/>[Persona]"]:::persona
    tv["<b>Pantalla de sala</b><br/>[Navegador en TV]"]:::persona

    subgraph filacero ["FilaCero [Sistema]"]
        direction TB
        spa["<b>Aplicación web</b><br/>[Contenedor: React 19 + Vite]<br/>Portal ciudadano, panel admin,<br/>consola del asesor, pantalla de sala"]:::contenedor
        proxy["<b>Servidor web / proxy</b><br/>[Contenedor: nginx]<br/>Sirve la SPA, TLS, cabeceras de seguridad,<br/>límite de peticiones, proxy a /api"]:::contenedor
        api["<b>API FilaCero</b><br/>[Contenedor: Python · Flask · waitress]<br/>Monolito modular: reservas, despacho,<br/>catálogo, personal, seguridad, auditoría"]:::contenedor
        bd[("<b>Base de datos</b><br/>[Contenedor: MySQL 8]<br/>Sedes, servicios, franjas, turnos,<br/>usuarios, bitácora")]:::datos
    end

    sms["<b>Proveedor de SMS</b><br/>[Externo · pendiente]"]:::pendiente

    ciudadano -- "HTTPS" --> proxy
    personal -- "HTTPS" --> proxy
    tv -- "HTTPS" --> proxy
    proxy -- "Entrega archivos estáticos" --> spa
    spa -- "JSON/REST + JWT<br/>(consulta cada 4–20 s)" --> proxy
    proxy -- "HTTP interno :5000" --> api
    api -- "SQL (SQLAlchemy, PyMySQL)<br/>transacciones + bloqueo de fila" --> bd
    api -. "HTTPS (por contratar)" .-> sms
    classDef persona fill:#0f2a2e,stroke:#0f2a2e,color:#ffffff
    classDef sistema fill:#135e63,stroke:#0d4a4f,color:#ffffff
    classDef externo fill:#8a9b9e,stroke:#5b6b6e,color:#ffffff
    classDef contenedor fill:#1d7a80,stroke:#0d4a4f,color:#ffffff
    classDef datos fill:#2458a6,stroke:#173d78,color:#ffffff
    classDef componente fill:#d5e8e5,stroke:#135e63,color:#0f2a2e
    classDef nodo fill:#f7f9f8,stroke:#51676b,color:#0f2a2e,stroke-dasharray: 4 3
    classDef pendiente fill:#fbecd2,stroke:#a65d00,color:#4a2a00,stroke-dasharray: 5 4
    style filacero fill:#f3f8f6,stroke:#135e63,color:#0f2a2e
