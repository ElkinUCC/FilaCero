flowchart TB
    ciudadano["<b>Ciudadano</b><br/>[Persona]<br/>Reserva, consulta o cancela su turno<br/>sin crear cuenta"]:::persona
    asesor["<b>Asesor</b><br/>[Persona]<br/>Atiende los turnos de su sede"]:::persona
    admin["<b>Administrador / Supervisor</b><br/>[Persona]<br/>Gestiona sedes, servicios, personal<br/>y supervisa la puntualidad"]:::persona
    sala["<b>Sala de espera</b><br/>[Pantalla pública]<br/>Muestra y anuncia el turno llamado"]:::persona

    filacero["<b>FilaCero</b><br/>[Sistema de software]<br/>Reserva por franjas de 30 min y despacho<br/>que garantiza la atención dentro de la franja"]:::sistema

    sms["<b>Proveedor de SMS</b><br/>[Sistema externo · pendiente]<br/>Envía el código de verificación"]:::pendiente
    correo["<b>Navegador del usuario</b><br/>[Externo]<br/>Síntesis de voz del sistema operativo"]:::externo

    ciudadano -- "Reserva y consulta<br/>[HTTPS]" --> filacero
    asesor -- "Llama, atiende y cierra turnos<br/>[HTTPS]" --> filacero
    admin -- "Configura y supervisa<br/>[HTTPS]" --> filacero
    sala -- "Consulta turnos llamados<br/>[HTTPS, cada 4 s]" --> filacero
    filacero -. "Solicita envío de código<br/>[HTTPS · por contratar]" .-> sms
    sms -. "SMS con código" .-> ciudadano
    filacero -- "Anuncios accesibles<br/>[Web Speech API]" --> correo
    classDef persona fill:#0f2a2e,stroke:#0f2a2e,color:#ffffff
