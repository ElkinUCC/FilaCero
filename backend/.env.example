# ============================================================
# FilaCero - variables de entorno (copiar como .env)
# NUNCA subas el archivo .env real a Git.
# ============================================================

# development | production
FLASK_ENV=development
FLASK_DEBUG=true

# Genera claves con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXP_MINUTES=60

# Orígenes permitidos para el frontend (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de datos MySQL
DB_USER=filacero_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3307
DB_NAME=filacero_db
DB_CHARSET=utf8mb4
# Alternativa para demo sin MySQL:
# DATABASE_URL=sqlite:///filacero_demo.db

# Horario demo: todos los días, 24 horas (Colombia)
HORA_APERTURA=0
HORA_CIERRE=24
DIAS_ATENCION=0,1,2,3,4,5,6
DURACION_FRANJA_MIN=30
# Regla de puntualidad: atención máxima de 10 min => 3 personas por asesor
# en cada franja de 30 min. El cupo es por SEDE (todos los trámites juntos).
DURACION_MAX_ATENCION_MIN=10
# 0 = calcular (30 / 10 = 3). Pon 4 si quieres 4 por asesor.
CUPOS_POR_ASESOR_FRANJA=0
# Pausa activa sugerida por el asistente cuando el asesor va adelantado
PAUSA_ACTIVA_SEG=90
DIAS_MAX_RESERVA=30
FRANJAS_AUTOMATICAS=true
# false = el agente puede atender a cualquier hora (útil para pruebas)
RESTRINGIR_ATENCION_HORARIO=true

# Solo para desarrollo local: en modo prueba el código se muestra en pantalla.
# En producción debe ser false.
FILACERO_OTP_TEST_MODE=true
# Demo gratis opcional: solo acepta este celular dedicado y muestra el código fijo.
# No usar con números/datos de clientes. El código de demo es público.
FILACERO_OTP_DEMO_ENABLED=false
FILACERO_OTP_DEMO_PHONE=
FILACERO_OTP_DEMO_CODE=

# Límites por minuto y por IP
LIMITE_LOGIN_POR_MINUTO=10
LIMITE_OTP_POR_MINUTO=5
LIMITE_PUBLICO_POR_MINUTO=60

# Seguridad de cuentas
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=15
# Registro público con contraseña (los ciudadanos no lo necesitan). false en producción.
REGISTRO_PUBLICO=true
# Número de proxies delante de Flask (1 si hay nginx) para obtener la IP real
PROXIES_CONFIABLES=0
# true: el asesor solo ve los turnos de hoy (recomendado en operación real)
COLA_SOLO_HOY=false
# Pantalla de sala: true = nombre completo de la persona llamada (ADR-008);
# false = solo nombre e inicial. El celular nunca se muestra en la sala.
SALA_NOMBRE_COMPLETO=true
LOG_LEVEL=INFO

# Cuentas que no se pueden desactivar ni cambiar de rol desde el panel y que
# "python simulacion.py --cargar" conserva (con su contraseña). Se crean con:
#   python scripts/crear_cuenta.py correo@filacero.com ADMIN "Nombre"
CUENTAS_PROTEGIDAS=elkinadmin@filacero.com,elkinagente@filacero.com

# Organización por defecto para solicitudes públicas y compatibilidad inicial
DEFAULT_ORGANIZATION_SLUG=filacero-demo

# Asistente FilaCero IA
# Sin clave responde el motor local (gratis, sin internet, sin datos fuera del servidor).
# Con clave de Anthropic, Claude redacta las respuestas usando solo indicadores
# sin celulares ni cédulas. IA_PROVEEDOR=local fuerza el motor local.
ANTHROPIC_API_KEY=
IA_PROVEEDOR=auto
IA_MODELO=claude-haiku-5-5
IA_TIMEOUT_SEG=12
LIMITE_ASISTENTE_POR_MINUTO=30
